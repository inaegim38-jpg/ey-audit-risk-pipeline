# Aegis-Guard external integration contract
# Copy to .env locally; never commit the real file or secrets.

# PostgreSQL used by console, SQL verification, and n8n Postgres credential.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=audit_db
PGUSER=audit_admin
PGPASSWORD=replace-me

# OpenDART disclosure API. Required for real WF-1 execution.
DART_API_KEY=replace-with-opendart-key
# JSON array of engagement monitoring targets; no corp codes in workflow source.
AEGIS_WATCH_TARGETS_JSON='[{"corp_code":"00123456","engagement_id":"ENG-2026-001"}]'

# Bank of Korea ECOS statistics API. Required for real macro/FX ingestion.
ECOS_API_KEY=replace-with-ecos-key
# Public Data Portal / procurement API. Required for real 나라장터 ingestion.
DATA_GO_KR_API_KEY=replace-with-public-data-portal-key
# PBC intake metadata; raw files are hashed before this metadata is accepted.
AEGIS_PBC_INPUTS_JSON='[{"engagement_id":"ENG-2026-001","file_name":"GL_202603.csv","sha256_hash":"replace-with-64-char-sha256","row_count":0,"debit_credit_diff":0}]'

# n8n notification credential is configured in n8n, not in Git.
# SLACK_WEBHOOK_URL=replace-with-n8n-credential

# Optional external model provider for a real AI extraction runner.
# The Phase 3 deterministic harness itself does not require a model key.
# OPENAI_API_KEY=replace-with-provider-key
# ANTHROPIC_API_KEY=replace-with-provider-key
