{
  "id": "aegis-wf4-aiqa-workpaper",
  "name": "[Aegis] WF-4 AI QA → 예외 큐 → 조서 manifest",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul",
    "saveManualExecutions": true
  },
  "tags": [
    {
      "name": "audit_core"
    }
  ],
  "nodes": [
    {
      "id": "wf4-1",
      "name": "Schedule: AI QA 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "wf4-2",
      "name": "Postgres: 골드셋 QA 실행",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM audit_core.run_ai_qa_goldset($1);",
        "options": {
          "queryReplacement": "ENG-2026-001"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PG_CRED",
          "name": "Postgres audit_db"
        }
      }
    },
    {
      "id": "wf4-3",
      "name": "Postgres: AI QA 요약",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM audit_core.vw_ai_qa_goldset_summary WHERE engagement_id = $1;",
        "options": {
          "queryReplacement": "ENG-2026-001"
        }
      },
      "credentials": {
        "postgres": {
          "id": "PG_CRED",
          "name": "Postgres audit_db"
        }
      }
    },
    {
      "id": "wf4-4",
      "name": "Code: 조서 export manifest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const summary = $json;\nreturn [{ json: {\n  export_type: 'AI_QA_WORKPAPER',\n  engagement_id: summary.engagement_id,\n  generated_at: new Date().toISOString(),\n  qa_summary: summary,\n  human_review_required: Number(summary.fail_count || 0) > 0 || Number(summary.review_count || 0) > 0,\n} }];"
      }
    },
    {
      "id": "wf4-5",
      "name": "IF: QA 예외 존재",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.human_review_required }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "isTrue"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "wf4-6",
      "name": "Slack: AI QA 검토 요청",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1180,
        -80
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#audit-alerts",
          "mode": "name"
        },
        "text": "=[Aegis] AI QA 예외 — 3-Pane 검토 및 조서 보류 필요"
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_CRED",
          "name": "Slack"
        }
      }
    },
    {
      "id": "wf4-7",
      "name": "NoOp: 조서 manifest 보관",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1180,
        80
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule: AI QA 09:00": {
      "main": [
        [
          {
            "node": "Postgres: 골드셋 QA 실행",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres: 골드셋 QA 실행": {
      "main": [
        [
          {
            "node": "Postgres: AI QA 요약",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres: AI QA 요약": {
      "main": [
        [
          {
            "node": "Code: 조서 export manifest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: 조서 export manifest": {
      "main": [
        [
          {
            "node": "IF: QA 예외 존재",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: QA 예외 존재": {
      "main": [
        [
          {
            "node": "Slack: AI QA 검토 요청",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NoOp: 조서 manifest 보관",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}